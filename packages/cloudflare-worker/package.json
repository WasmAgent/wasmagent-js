{
  "name": "@wasmagent/cloudflare-worker",
  "version": "0.2.0",
  "description": "Cloudflare Workers integration for wasmagent — HTTP API with SSE streaming, KV session caching, and the CloudflareWorkflowEngine workflow adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepublishOnly": "bun run build",
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "clean": "rm -rf dist .wrangler .turbo"
  },
  "dependencies": {
    "@wasmagent/ag-ui": "workspace:*",
    "@wasmagent/core": "workspace:*",
    "@wasmagent/kernel-quickjs": "workspace:*",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "@wasmagent/models": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@cloudflare/workers-types": "^4.20241224.0",
    "@size-limit/preset-big-lib": "^12.1.0",
    "size-limit": "^12.1.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.93.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WasmAgent/wasmagent-js.git",
    "directory": "packages/cloudflare-worker"
  },
  "homepage": "https://github.com/WasmAgent/wasmagent-js/tree/main/packages/cloudflare-worker#readme",
  "bugs": {
    "url": "https://github.com/WasmAgent/wasmagent-js/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "wasmagent",
    "wasm",
    "agent",
    "portable",
    "sandbox",
    "executor",
    "ai",
    "llm",
    "typescript",
    "cloudflare-workers",
    "workflows"
  ],
  "wasmagent": {
    "tier": "tier-0",
    "stability": "stable"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "author": "wasmagent contributors"
}
